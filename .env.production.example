# =============================================================================
# .env.production.example — MẪU biến môi trường cho stack PRODUCTION
# -----------------------------------------------------------------------------
# CÁCH DÙNG TRÊN VPS:
#   1. mkdir -p /srv/hrm-prod && cd /srv/hrm-prod && git clone <repo> .
#   2. cp .env.production.example .env
#   3. Điền giá trị thật, rồi khoá quyền:  chmod 600 .env
#   4. ./deploy.sh
#
# SECRET KHÔNG BAO GIỜ NẰM TRONG GIT. File ".env" đã bị .gitignore và CI có job
# `secret-scan` chặn nếu ai đó cố commit. Nơi lưu secret:
#   - trên VPS: file .env này (chmod 600, chỉ user deploy đọc được)
#   - trong CI: GitHub → Settings → Secrets and variables → Actions
#
# Sinh secret ngẫu nhiên:
#   openssl rand -hex 32
# =============================================================================

# ---- Chọn stack + chế độ mạng -----------------------------------------------
# STACK_NAME quyết định tiền tố network/volume -> production và staging trên
# cùng VPS không dùng chung database.
STACK_NAME=hrm-prod
APP_ENV=production

# COMPOSE_FILE: docker compose tự đọc biến này, khỏi gõ -f mỗi lệnh.
#   https  = có tên miền, Caddy lo TLS (KHUYẾN NGHỊ cho production)
#   expose = chưa có tên miền, mở cổng WEB_PORT chạy HTTP thuần
COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# Tên miền production. DNS A record phải trỏ về IP VPS TRƯỚC khi khởi động,
# nếu không Let's Encrypt cấp chứng chỉ hỏng.
PUBLIC_DOMAIN=hrm.soosky.co

# Chỉ dùng khi COMPOSE_FILE là ...:docker-compose.expose.yml
WEB_PORT=80

# ---- MongoDB -----------------------------------------------------------------
# DB chạy trong mạng nội bộ Docker (không "ports:") nên không lộ ra Internet.
# Replica set tên "rs0", khởi tạo tự động bởi service mongo-init.
MONGODB_DB=soosky-hrm

# ---- JWT (bắt buộc, >= 32 ký tự) --------------------------------------------
AUTH_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
AUTH_ACCOUNT_VERIFICATION_BASE_URL=https://hrm.soosky.co/auth/verify-account

# Cùng domain qua Caddy -> same-origin -> KHÔNG cần CORS. Để trống.
HTTP_CORS_ORIGINS=

# ---- SMTP THẬT (bắt buộc — backend từ chối khởi động nếu thiếu SMTP_HOST) ----
# Production không được phép "email chỉ ghi log": thư mời tài khoản và đặt lại
# mật khẩu phải tới được người nhận.
# Gmail/Google Workspace: SMTP_PASS là App Password 16 ký tự (bật 2FA rồi tạo
# tại https://myaccount.google.com/apppasswords), và MAIL_FROM phải trùng
# SMTP_USER (hoặc alias đã khai báo) vì Gmail ghi đè người gửi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dev.bot@vn.soosky.co
SMTP_PASS=CHANGE_ME_app_password
MAIL_FROM=Soosky HRM <dev.bot@vn.soosky.co>

# ---- Sao lưu -----------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_AT_HOUR=19          # 19:00 UTC = 02:00 giờ VN
BACKUP_KEEP_DAYS=7         # số bản giữ trên đĩa VPS (bản trên S3 do bucket lo)

# ---- Object storage (Backblaze B2 / S3) --------------------------------------
# Dùng cho cả upload tài liệu nhân sự lẫn nơi cất backup.
# Để trống S3_BUCKET -> backup chỉ nằm trên VPS (mất VPS là mất backup).
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL=900
