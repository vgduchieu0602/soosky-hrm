# =============================================================================
# .env.docker.example — MẪU biến môi trường cho docker-compose
# -----------------------------------------------------------------------------
# CÁCH DÙNG:
#   1. Copy file này thành ".env" (cùng thư mục docker-compose.yml):
#        cp .env.docker.example .env
#   2. Điền giá trị thật (đặc biệt các secret). docker-compose tự đọc file ".env".
#   3. ".env" ĐÃ bị .gitignore -> KHÔNG commit secret lên git.
#
# Sinh secret ngẫu nhiên (chạy trên VPS Linux):
#   openssl rand -hex 32      # cho mỗi JWT secret
#   openssl rand -hex 24      # cho MONGO_REPLICA_SET_KEY và mật khẩu Mongo
# =============================================================================

# ---- Domain công khai (Caddy proxy chung định tuyến theo giá trị này) --------
# Mỗi dự án trên VPS có 1 domain/subdomain riêng. Caddy tự cấp HTTPS cho nó.
PUBLIC_DOMAIN=hrm.your-domain.com

# ---- MongoDB -----------------------------------------------------------------
MONGO_ROOT_USER=hrm_root
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_password
MONGO_DB_NAME=soosky_hrm
# Khoá xác thực nội bộ giữa các node replica set (6-1024 ký tự, không khoảng trắng).
MONGO_REPLICA_SET_KEY=CHANGE_ME_replica_set_key

# ---- JWT (bắt buộc >= 32 ký tự) ---------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_64_hex_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
BCRYPT_ROUND=10

# ---- App / Mail --------------------------------------------------------------
# URL web công khai (dùng để dựng link đăng nhập trong email). Đổi thành domain thật.
APP_WEB_URL=https://hrm.your-domain.com
MAIL_FROM=Soosky HRM <no-reply@soosky.co>
# Để trống SMTP_HOST -> email chỉ ghi log, KHÔNG gửi thật (tiện khi mới deploy).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Object storage (Backblaze B2 / S3) — để trống S3_BUCKET nếu chưa dùng upload
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL=900
