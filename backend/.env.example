NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/soosky_hrm?replicaSet=rs

JWT_ACCESS_SECRET=replace-with-64-byte-random-hex
JWT_REFRESH_SECRET=replace-with-64-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

BCRYPT_ROUNDS=10

# Web client base URL (used to build the login link inside emails)
APP_WEB_URL=http://localhost:5173

# Mail — sender identity
MAIL_FROM=Soosky HRM <no-reply@soosky.co>

# SMTP — leave SMTP_HOST empty to use the dev log transport (emails not delivered).
# When set, account credential / password-reset emails are delivered via nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
