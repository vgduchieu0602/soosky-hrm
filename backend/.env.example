NODE_ENV="development"

HTTP_HOST="localhost"
HTTP_PORT=3000
# CORS: danh sách origin (phân tách bằng dấu phẩy) được phép gọi API từ trình
# duyệt — cần khi UI chạy khác domain với API. Để trống → không bật CORS
# (same-origin hoặc sau reverse proxy cùng domain). "*" chỉ dùng khi dev.
HTTP_CORS_ORIGINS="https://workspace.soosky.co"

MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="soosky-workspace"

# SMTP gửi mail — bắt buộc ở production; để trống SMTP_HOST thì mặc định
# localhost:1025 (SMTP dev như Mailpit/MailHog, xem mail ở web UI cổng 8025).
# Mặc định bên dưới cấu hình cho Gmail:
# - SMTP_USER là địa chỉ Gmail/Google Workspace đầy đủ.
# - SMTP_PASS là App Password 16 ký tự (cần bật 2-Step Verification, tạo tại
#   https://myaccount.google.com/apppasswords) — không dùng mật khẩu thường.
# - Gmail ghi đè người gửi bằng tài khoản đã xác thực, nên MAIL_FROM phải
#   trùng SMTP_USER (hoặc alias đã khai báo trong Gmail).
SMTP_HOST="smtp.gmail.com"
# 465 → TLS ngầm định (SMTP_SECURE=true); 587 → STARTTLS (SMTP_SECURE=false).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="dev.bot@vn.soosky.co"
SMTP_PASS=
MAIL_FROM="Soosky Workspace <dev.bot@vn.soosky.co>"

AUTH_JWT_SECRET=
AUTH_ACCOUNT_VERIFICATION_BASE_URL=
