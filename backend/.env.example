NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/soosky_hrm?replicaSet=rs

JWT_ACCESS_SECRET=replace-with-64-byte-random-hex
JWT_REFRESH_SECRET=replace-with-64-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

BCRYPT_ROUND=10

# Web client base URL (used to build the login link inside emails)
APP_WEB_URL=http://localhost:5173

# Mail — sender identity
MAIL_FROM=Soosky HRM <no-reply@soosky.co>

# SMTP — leave SMTP_HOST empty to use the dev log transport (emails not delivered).
# When set, account credential / password-reset emails are delivered via nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# Object storage — Backblaze B2 (S3-compatible)
# Leave S3_BUCKET empty to disable file uploads (presign endpoints return 503).
#
# Where to find these in the Backblaze console:
#   1. Create a bucket (set it Private). Its name → S3_BUCKET.
#   2. Bucket detail shows an "Endpoint" like: s3.us-west-004.backblazeb2.com
#      → S3_ENDPOINT must include the https:// scheme.
#      → The region is the middle segment, e.g. us-west-004 → S3_REGION.
#   3. App Keys → "Add a New Application Key" (scope it to the bucket).
#      keyID → S3_ACCESS_KEY_ID, applicationKey → S3_SECRET_ACCESS_KEY
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How long (seconds) a presigned upload/download URL stays valid. Default 900 (15 min).
S3_PRESIGN_TTL=900
