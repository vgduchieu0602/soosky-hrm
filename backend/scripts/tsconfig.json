{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"],
      "@infra/*": ["../src/infra/*"],
      "@modules/*": ["../src/modules/*"],
      "@shared/*": ["../src/shared/*"],
      "@features/*": ["../src/features/*"]
    }
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
