{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"],
      "@config/*": ["../src/config/*"],
      "@core/*": ["../src/core/*"],
      "@shared/*": ["../src/shared/*"],
      "@features/*": ["../src/features/*"]
    }
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
