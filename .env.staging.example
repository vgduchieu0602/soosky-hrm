# =============================================================================
# .env.staging.example — MẪU biến môi trường cho stack STAGING
# -----------------------------------------------------------------------------
# Staging là bản sao production dùng để thử trước khi lên thật. Nó chạy TRÊN
# CÙNG VPS được, miễn STACK_NAME khác -> network/volume khác -> DATABASE KHÁC.
#
# CÁCH DÙNG:
#   1. mkdir -p /srv/hrm-staging && cd /srv/hrm-staging && git clone <repo> .
#   2. git checkout develop        (staging bám nhánh develop, prod bám master)
#   3. cp .env.staging.example .env  &&  chmod 600 .env
#   4. ./deploy.sh
#
# KHÁC BIỆT CỐ Ý so với production:
#   - domain riêng (staging.hrm.soosky.co) -> không ai nhầm với hệ thật
#   - secret RIÊNG, không tái dùng của production (lộ staging ≠ lộ production)
#   - SMTP trỏ hộp thư kỹ thuật + MAIL_FROM ghi rõ [STAGING] để không ai tưởng
#     đó là thư thật gửi cho nhân viên
#   - backup giữ ít ngày hơn, không cần đẩy lên S3
# =============================================================================

STACK_NAME=hrm-staging
APP_ENV=staging

COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
PUBLIC_DOMAIN=staging.hrm.soosky.co

# Chỉ dùng nếu chuyển sang docker-compose.expose.yml (chưa có tên miền staging).
WEB_PORT=8081

# ---- MongoDB -----------------------------------------------------------------
MONGODB_DB=soosky-hrm-staging

# ---- JWT — PHẢI khác production ---------------------------------------------
AUTH_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32_KHAC_PRODUCTION
AUTH_ACCOUNT_VERIFICATION_BASE_URL=https://staging.hrm.soosky.co/auth/verify-account
HTTP_CORS_ORIGINS=

# ---- SMTP thật, nhưng gửi tới hộp thư kỹ thuật -------------------------------
# Vẫn dùng SMTP THẬT (không phải Mailpit) để kiểm chứng đúng đường gửi mail sẽ
# chạy ở production. Nhãn [STAGING] trong MAIL_FROM để người nhận phân biệt ngay.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dev.bot@vn.soosky.co
SMTP_PASS=CHANGE_ME_app_password
MAIL_FROM=[STAGING] Soosky HRM <dev.bot@vn.soosky.co>

# ---- Sao lưu -----------------------------------------------------------------
# Staging là dữ liệu thử: vẫn backup để có cái mà diễn tập restore, nhưng giữ
# ngắn ngày và không tốn dung lượng S3.
BACKUP_ENABLED=true
BACKUP_AT_HOUR=20
BACKUP_KEEP_DAYS=3

# ---- Object storage ----------------------------------------------------------
# Bucket RIÊNG cho staging — không bao giờ trỏ vào bucket production.
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL=900
